package com.orders.Service;

import java.time.LocalDateTime;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.netflix.discovery.converters.Auto;
import com.orders.entity.OrderEntity;
import com.orders.entity.OrderItemEntity;
import com.orders.inventory.InventoryClient;
import com.orders.repository.OrderItemRepo;
import com.orders.repository.OrderRepository;
import com.orders.requestDTO.InventoryDto;
import com.orders.requestDTO.OrderRequest;
import com.orders.response.OrderResponse;
import com.orders.response.ProductResponse;

@Service
public class OrderService {

	@Autowired
	OrderItemRepo itemRepo;
	@Autowired

	OrderRepository orderRepository;
	private final InventoryClient client;

	public OrderService(InventoryClient inventoryClient) {
		this.client = inventoryClient;
	}

	// placing order
	public OrderResponse placeOrder(OrderRequest request) {

		ProductResponse dto = client.getProduct(request.getProductId());
		InventoryDto inventoryStock = client.getInventory(request.getProductId());

		if (inventoryStock == null) {
			throw new RuntimeException("Bad Request! Rejecting Order.");
		} else if (inventoryStock.getAvailableQuantity() < request.getQuantity()) {

			inventoryStock = client.reduceStock(request.getProductId(), request.getQuantity());
		}

		else {

			OrderItemEntity itemEntity = new OrderItemEntity();

			itemEntity.setProductId(inventoryStock.getProductId());
			itemEntity.setQuantity(inventoryStock.getAvailableQuantity());
			itemEntity.setPrice(dto.getPrice());

			OrderEntity orderEntity = new OrderEntity();

			orderEntity.setCustomerId(101l);
			orderEntity.setOrderDate(LocalDateTime.now());
			orderEntity.setOrderStatus("Shipped");
			orderEntity.setTotalAmount(dto.getPrice() * request.getQuantity());

			OrderEntity orders = orderRepository.save(orderEntity);

			itemEntity.setOrderId(orders.getOrderId());
			itemRepo.save(itemEntity);

			OrderResponse ordersResp = new OrderResponse();
			ordersResp.setCustomerId(orders.getCustomerId());
			ordersResp.setOrderDate(orders.getOrderDate());
			ordersResp.setOrderId(orders.getOrderId());
			ordersResp.setOrderStatus(orders.getOrderStatus());
			ordersResp.setTotalAmount(orders.getTotalAmount());

			return ordersResp;
		}
	}

}
